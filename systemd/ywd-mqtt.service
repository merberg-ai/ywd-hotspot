[Unit]
Description=YWD-Hotspot loopback MQTT telemetry broker
After=network.target
Before=ywd-mmdvmhost.service ywd-mmdvm-telemetry.service
ConditionPathExists=/opt/ywd-hotspot/app/lib/ywd-mosquitto.conf

[Service]
Type=simple
User=mosquitto
Group=mosquitto
ExecStart=/usr/sbin/mosquitto -c /opt/ywd-hotspot/app/lib/ywd-mosquitto.conf
# Type=simple only proves the Mosquitto process was spawned; on a Pi Zero the
# dependent MMDVM processes can otherwise reach localhost:1883 before the
# broker has bound its socket. Hold service startup briefly until the listener
# is genuinely ready so YWD Extended passive voice/telemetry is deterministic.
ExecStartPost=/bin/bash -c 'for i in {1..60}; do if exec 3<>/dev/tcp/127.0.0.1/1883; then exec 3>&-; exec 3<&-; exit 0; fi; sleep 0.1; done; exit 1'
TimeoutStartSec=10
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
