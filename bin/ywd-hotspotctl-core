#!/usr/bin/env bash
set -euo pipefail
APP=/opt/ywd-hotspot/app
CFG=/etc/ywd-hotspot/config.json
ADMIN=/usr/local/libexec/ywd-hotspot-admin
BUILD_INFO=/etc/ywd-hotspot/build-info.json
UPDATE_CHANNEL=/etc/ywd-hotspot/update-channel
CALIBRATION=/var/lib/ywd-hotspot/calibration.json
CAL_BASELINE=/var/lib/ywd-hotspot/calibration-baseline.json

# Canonical config and build provenance live under a deliberately protected
# /etc/ywd-hotspot directory because the same directory contains reusable
# credentials. Read-only CLI commands transparently elevate only when needed.
if [[ $EUID -ne 0 ]]; then
  case "${1:-}" in
    status|source|calibration)
      if [[ ! -r "$CFG" || ! -r "$BUILD_INFO" || ( "${1:-}" == calibration && ! -r "$CALIBRATION" ) ]]; then
        echo "YWD-Hotspot protected metadata requires sudo; elevating this read-only command..." >&2
        exec sudo "$0" "$@"
      fi
      ;;
    update-channel)
      exec sudo "$0" "$@"
      ;;
  esac
fi

need_root(){ [[ $EUID -eq 0 ]] || { echo "Run with sudo: sudo ywd-hotspotctl $*"; exit 1; }; }
unit_exists(){ systemctl cat "$1" >/dev/null 2>&1; }
oled_unit(){ if unit_exists ywd-headless-oled.service; then printf '%s\n' ywd-headless-oled.service; else printf '%s\n' ywd-oled.service; fi; }

channel_value(){
  local c=""
  [[ -r "$UPDATE_CHANNEL" ]] && c="$(tr -d '[:space:]' < "$UPDATE_CHANNEL" 2>/dev/null || true)"
  case "$c" in main|dev) printf '%s\n' "$c"; return;; esac
  if [[ -r "$BUILD_INFO" ]]; then
    c="$(python3 - "$BUILD_INFO" <<'PY'
import json,sys
try: print(json.load(open(sys.argv[1])).get('update_channel',''))
except Exception: print('')
PY
)"
    case "$c" in main|dev) printf '%s\n' "$c"; return;; esac
  fi
  printf 'main\n'
}

status(){
  local ou
  ou="$(oled_unit)"
  echo "YWD Hotspot $(cat "$APP/VERSION" 2>/dev/null || echo unknown)"
  printf "%-18s %s\n" "MMDVMHost" "$(systemctl is-active ywd-mmdvmhost.service 2>/dev/null || true)"
  printf "%-18s %s\n" "DMRGateway" "$(systemctl is-active ywd-dmrgateway.service 2>/dev/null || true)"
  printf "%-18s %s\n" "Dashboard" "$(systemctl is-active ywd-dashboard.service 2>/dev/null || true)"
  printf "%-18s %s\n" "Activity" "$(systemctl is-active ywd-activity.service 2>/dev/null || true)"
  printf "%-18s %s\n" "OLED" "$(systemctl is-active "$ou" 2>/dev/null || true)"
  printf "%-18s %s\n" "OLED owner" "$ou"
  python3 - <<'PY'
import json
try:
 c=json.load(open('/etc/ywd-hotspot/config.json')); s=c['station']; r=c['radio']; b=c['brandmeister']; w=c['web']; m=c.get('maintenance',{})
 print(f"{'Callsign':18} {s.get('callsign','?')}")
 print(f"{'Hotspot ID':18} {s.get('hotspot_id','?')}")
 print(f"{'Frequency':18} {r.get('frequency_hz',0)/1e6:.6f} MHz")
 print(f"{'Color Code':18} {r.get('color_code','?')}")
 print(f"{'RX/TX Offset':18} {r.get('rx_offset',0)} / {r.get('tx_offset',0)} Hz")
 print(f"{'BM Master':18} {b.get('master','?')}")
 print(f"{'RF autostart':18} {'enabled' if m.get('rf_autostart',False) else 'disabled'}")
 print(f"{'Dashboard':18} http://PI-IP:{w.get('port',8080)}/")
except Exception as e: print('Config:',e)
PY
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"; [[ -n "$ip" ]] && printf "%-18s %s\n" "IP" "$ip"
  command -v vcgencmd >/dev/null && printf "%-18s %s\n" "Throttle" "$(vcgencmd get_throttled 2>/dev/null || true)"
  [[ -x "$APP/lib/brandmeister.py" ]] && printf "%-18s %s\n" "BM API Key" "$(python3 "$APP/lib/brandmeister.py" key-status 2>/dev/null || echo unknown)"
  [[ -x "$APP/lib/web_auth.py" ]] && printf "%-18s %s\n" "Web Controls" "$(python3 "$APP/lib/web_auth.py" status 2>/dev/null || echo unknown)"
  if [[ -r "$BUILD_INFO" ]]; then
    python3 - "$BUILD_INFO" <<'PY2'
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
branch=d.get('branch','unknown'); commit=d.get('commit_short') or str(d.get('commit','unknown'))[:10]
print(f"{'Git source':18} {branch} @ {commit}")
PY2
  fi
  printf "%-18s %s\n" "Update channel" "$(channel_value)"
  if [[ -r /var/lib/ywd-hotspot/applied-state.json ]]; then
    python3 - <<'PY'
import json,sys
sys.path.insert(0,'/opt/ywd-hotspot/app/lib'); import config_model
c=config_model.normalize(json.load(open('/etc/ywd-hotspot/config.json'))); a=json.load(open('/var/lib/ywd-hotspot/applied-state.json'))
print(f"{'Config applied':18} {'yes' if a.get('hash')==config_model.hash_config(c,False) else 'NO - pending changes'}")
PY
  fi
}

source_info(){
  local channel="$(channel_value)"
  python3 - "$BUILD_INFO" "$channel" <<'PY2'
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
print("YWD-Hotspot source")
print(f"  Repository : {d.get('repository','https://github.com/merberg-ai/ywd-hotspot')}")
print(f"  Source     : {d.get('source','unknown')}")
print(f"  Branch     : {d.get('branch','unknown')}")
print(f"  Commit     : {d.get('commit','unknown')}")
print(f"  Commit date: {d.get('commit_date','unknown')}")
print(f"  State      : {d.get('source_state','unknown')}")
print(f"  Channel    : {sys.argv[2]}")
print(f"  Installed  : {d.get('version','unknown')}")
PY2
}

update_channel(){
  need_root update-channel
  local requested="${1:-}"
  if [[ -z "$requested" ]]; then
    echo "Update channel: $(channel_value)"
    echo "Available channels: main dev"
    return 0
  fi
  case "$requested" in main|dev) ;; *) echo "[FAIL] update channel must be 'main' or 'dev'"; return 2;; esac
  local tmp="${UPDATE_CHANNEL}.tmp"
  printf '%s\n' "$requested" > "$tmp"
  chmod 0644 "$tmp"
  chown root:root "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$UPDATE_CHANNEL"
  python3 - "$BUILD_INFO" "$requested" <<'PY'
import json,os,sys
from pathlib import Path
p=Path(sys.argv[1]); channel=sys.argv[2]
try: d=json.loads(p.read_text())
except Exception: d={}
d['update_channel']=channel
t=p.with_suffix(p.suffix+'.tmp'); t.write_text(json.dumps(d,indent=2)+'\n'); os.chmod(t,0o644)
try: os.chown(t,0,0)
except Exception: pass
os.replace(t,p)
PY
  echo "YWD-Hotspot update channel set to: $requested"
  echo "Future 'sudo ywd-hotspotctl update' commands will follow $requested."
}

github_update(){ need_root update; exec bash "$APP/GITHUB-UPDATE.sh" "$@"; }
migrate_github(){ need_root migrate-github; exec bash "$APP/MIGRATE-TO-GITHUB.sh" "$@"; }

logs(){ echo "=== MMDVM-Host ==="; journalctl -u ywd-mmdvmhost.service -n 100 --no-pager -o cat; echo; echo "=== DMRGateway ==="; journalctl -u ywd-dmrgateway.service -n 100 --no-pager -o cat; echo; echo "=== Dashboard ==="; journalctl -u ywd-dashboard.service -n 60 --no-pager -o cat; }

lastheard(){
  python3 - <<'PY'
import json
from pathlib import Path
try: rows=json.loads(Path('/var/lib/ywd-hotspot/lastheard.json').read_text())
except Exception: rows=[]
print(f"{'PATH':8} {'SLOT':4} {'SOURCE':12} {'DESTINATION':16} {'DUR':7} {'BER':7} {'LOSS/RSSI'}")
for x in rows[:30]:
 src=(x.get('source') or {}).get('display','?'); d=x.get('destination') or {}; dst=('TG ' if d.get('group') else 'PC ')+str(d.get('display','?'))
 dur='—' if x.get('duration_s') is None else f"{x['duration_s']:.1f}s"; ber='—' if x.get('ber_pct') is None else f"{x['ber_pct']:.1f}%"
 q=f"loss {x['packet_loss_pct']:.0f}%" if x.get('packet_loss_pct') is not None else (f"{x['rssi_dbm']} dBm" if x.get('rssi_dbm') is not None else '—')
 print(f"{x.get('path','?'):8} {str(x.get('slot','?')):4} {src[:12]:12} {dst[:16]:16} {dur:7} {ber:7} {q}")
PY
}

calibration(){
  local sub="${1:-summary}" fmt="${2:-json}"
  python3 - "$sub" "$fmt" <<'PY'
import csv,json,sys,time
from collections import defaultdict
from pathlib import Path
sub=sys.argv[1]; fmt=sys.argv[2]
def read(path, default):
 try: return json.loads(Path(path).read_text())
 except Exception: return default
doc=read('/var/lib/ywd-hotspot/calibration.json',{'tests':[]})
tests=[x for x in doc.get('tests',[]) if isinstance(x,dict) and x.get('ber_pct') is not None]
base=read('/var/lib/ywd-hotspot/calibration-baseline.json',None)
cfg=read('/etc/ywd-hotspot/config.json',{})
g=defaultdict(list)
for x in tests:
 try: g[int(x.get('rx_offset',0))].append(x)
 except Exception: pass
aggs=[]
for off,rows in sorted(g.items()):
 bers=[float(x['ber_pct']) for x in rows]
 rss=[float(x['rssi_dbm']) for x in rows if x.get('rssi_dbm') is not None]
 aggs.append({'rx_offset':off,'samples':len(rows),'avg_ber':round(sum(bers)/len(bers),3),'best_ber':round(min(bers),3),'avg_rssi':round(sum(rss)/len(rss),1) if rss else None})
ready=[x for x in aggs if x['samples']>=3]
best=min(ready,key=lambda x:(x['avg_ber'],-x['samples'],abs(x['rx_offset']))) if ready else None
provisional=min(aggs,key=lambda x:(x['avg_ber'],-x['samples'],abs(x['rx_offset']))) if aggs else None
if sub in ('summary','status'):
 print('YWD-Hotspot RX calibration')
 print(f"  Current RX offset : {cfg.get('radio',{}).get('rx_offset','?')} Hz")
 started=doc.get('session_started_at')
 if isinstance(started,(int,float)):
  print('  Session started   : '+time.strftime('%Y-%m-%d %H:%M:%S %Z',time.localtime(started)))
 else: print(f"  Session started   : {started or 'not started'}")
 print(f"  Baseline          : {'saved' if base else 'not saved'}")
 print(f"  Samples           : {len(tests)} across {len(aggs)} offset(s)")
 print('  Sample target     : 3 per offset before recommendation')
 print()
 print(f"{'RX OFFSET':>10}  {'N':>3}  {'AVG BER':>8}  {'BEST BER':>9}  {'AVG RSSI':>9}")
 for a in aggs:
  mark='*' if best and a['rx_offset']==best['rx_offset'] else ' '
  rssi='—' if a['avg_rssi'] is None else f"{a['avg_rssi']:.1f}"
  print(f"{mark}{a['rx_offset']:>9}  {a['samples']:>3}  {a['avg_ber']:>7.3f}%  {a['best_ber']:>8.3f}%  {rssi:>9}")
 print()
 if best: print(f"Recommended RX offset: {best['rx_offset']} Hz ({best['samples']} samples, {best['avg_ber']:.3f}% average BER)")
 elif provisional: print(f"Provisional best: {provisional['rx_offset']} Hz ({provisional['samples']}/3 samples, {provisional['avg_ber']:.3f}% average BER)")
 else: print('No RF calibration samples recorded yet.')
 raise SystemExit(0)
if sub != 'export':
 raise SystemExit("Usage: ywd-hotspotctl calibration [summary|export json|export csv]")
if fmt == 'json':
 print(json.dumps({'session_started_at':doc.get('session_started_at'),'sample_target':3,'baseline':base,'samples':tests,'aggregates':aggs,'recommended':best,'provisional':provisional},indent=2))
elif fmt == 'csv':
 w=csv.writer(sys.stdout); w.writerow(['time','rx_offset_hz','ber_pct','rssi_dbm','duration_s','source','destination'])
 for x in tests: w.writerow([x.get('time',''),x.get('rx_offset',''),x.get('ber_pct',''),x.get('rssi_dbm',''),x.get('duration_s',''),x.get('source',''),x.get('destination','')])
else:
 raise SystemExit('export format must be json or csv')
PY
}

set_autostart(){
  local v="$1"
  python3 - "$v" <<'PY'
import json,os,sys
from pathlib import Path
p=Path('/etc/ywd-hotspot/config.json'); c=json.load(open(p)); c.setdefault('maintenance',{})['rf_autostart']=sys.argv[1]=='1'; t=p.with_suffix('.tmp'); t.write_text(json.dumps(c,indent=2)+'\n'); os.chmod(t,0o640)
try:
 import grp; os.chown(t,0,grp.getgrnam('ywd-hotspot').gr_gid)
except Exception: pass
os.replace(t,p)
PY
}

restart_running(){
  need_root restart
  python3 "$APP/lib/generate-config.py"
  echo "Restarting only currently-running services..."
  local ga=0 ou oa=0
  ou="$(oled_unit)"
  systemctl is-active --quiet ywd-dmrgateway.service && ga=1 || true
  systemctl is-active --quiet "$ou" && oa=1 || true
  ((ga)) && systemctl stop ywd-dmrgateway.service || true
  systemctl try-restart ywd-mmdvmhost.service || true
  ((ga)) && { sleep 1; systemctl start ywd-dmrgateway.service; }
  systemctl try-restart ywd-activity.service || true
  if ((oa)); then
    if ! printf '{"service":"oled"}\n' | "$ADMIN" service-restart >/dev/null; then
      echo "[WARN] OLED restart failed; current owner: $ou"
    fi
  fi
  status
}
start_rf(){ need_root start; echo "Verify antenna/frequency before RF start."; read -r -p "Type ENABLE-RF to start AND enable RF at boot: " a; [[ "$a" == ENABLE-RF ]] || { echo Cancelled.; return; }; set_autostart 1; python3 "$APP/lib/generate-config.py"; systemctl enable --now ywd-mmdvmhost.service; sleep 1; systemctl enable --now ywd-dmrgateway.service; printf '{}\n' | "$ADMIN" init-applied >/dev/null; status; }
stop_rf(){ need_root stop; systemctl disable --now ywd-dmrgateway.service ywd-mmdvmhost.service || true; set_autostart 0; printf '{}\n' | "$ADMIN" init-applied >/dev/null; echo "RF/network path stopped and disabled at boot."; }
backup(){ need_root backup; mkdir -p /var/backups/ywd-hotspot; out="/var/backups/ywd-hotspot/ywd-hotspot-$(date +%Y%m%d-%H%M%S).tar.gz"; tar -czf "$out" /etc/ywd-hotspot 2>/dev/null; chmod 600 "$out"; echo "Backup: $out"; echo "NOTE: protected backup contains credentials."; }
configure(){ need_root configure; python3 "$APP/lib/configure.py"; }
apply_config(){ need_root apply; echo '{}' | "$ADMIN" config-apply | python3 -m json.tool; }
health(){ python3 "$APP/lib/health.py"; }
diagnostics(){ need_root diagnostics; echo '{}' | "$ADMIN" diagnostics | python3 -m json.tool; }
history(){ [[ -r /var/lib/ywd-hotspot/config-history.json ]] && python3 -m json.tool /var/lib/ywd-hotspot/config-history.json || echo "No config history yet."; }
lab(){ need_root lab; "$APP/lab/mmdvm-diag.sh"; }
bm_api_key(){ need_root bm-api-key; python3 "$APP/lib/brandmeister.py" set-key; systemctl try-restart ywd-dashboard.service 2>/dev/null || true; }
web_password(){ need_root web-password; python3 "$APP/lib/web_auth.py" set; systemctl try-restart ywd-dashboard.service 2>/dev/null || true; }
update_ids(){ need_root update-ids; python3 "$APP/lib/id-update.py" --force; }

bm(){ local cmd="${1:-profile}"; shift || true; need_root bm; case "$cmd" in profile) python3 "$APP/lib/brandmeister.py" profile;; dropqso) python3 "$APP/lib/brandmeister.py" dropqso 0;; dropdyn) python3 "$APP/lib/brandmeister.py" dropdyn 0;; addtg) [[ "${1:-}" =~ ^[0-9]+$ ]] || { echo "Usage: bm addtg TG"; return 2; }; python3 "$APP/lib/brandmeister.py" addtg "$1" 0;; deltg) [[ "${1:-}" =~ ^[0-9]+$ ]] || { echo "Usage: bm deltg TG"; return 2; }; python3 "$APP/lib/brandmeister.py" deltg "$1" 0;; *) echo "Usage: bm {profile|dropqso|dropdyn|addtg TG|deltg TG}"; return 2;; esac; }

menu(){ while true; do clear; echo "========================================"; echo " YWD Hotspot Control - Alpha7 dev"; echo "========================================"; cat <<'EOF'
 1) Status                 9) Stop/disable RF
 2) Last Heard            10) Configure BM API key
 3) Logs                  11) Configure web password
 4) Restart running stack 12) Update DMR IDs now
 5) Configure (CLI)       13) Drop current BM QSO
 6) Apply saved config    14) Drop all dynamic TGs
 7) Health                15) Create diagnostic bundle
 8) Start/enable RF       16) Config history
17) Hardware Lab          21) Calibration summary
18) Source/build info     22) Show update channel
19) Check GitHub update   23) Set channel to dev
20) Update from GitHub    24) Set channel to main
 0) Exit
EOF
 read -r -p "Select: " n; case "$n" in 1)status;;2)lastheard;;3)logs;;4)restart_running;;5)configure;;6)apply_config;;7)health;;8)start_rf;;9)stop_rf;;10)bm_api_key;;11)web_password;;12)update_ids;;13)bm dropqso;;14)bm dropdyn;;15)diagnostics;;16)history;;17)lab;continue;;18)source_info;;19)github_update --check;continue;;20)github_update;continue;;21)calibration;;22)update_channel;;23)update_channel dev;;24)update_channel main;;0)return;;esac; read -r -p "Enter..." _; done; }

cmd="${1:-menu}"; shift || true
case "$cmd" in status)status;; source)source_info;; update)github_update "$@";; update-channel)update_channel "$@";; calibration)calibration "$@";; migrate-github)migrate_github "$@";; logs)logs;; lastheard)lastheard;; restart)restart_running;; configure)configure;; apply)apply_config;; health)health;; diagnostics)diagnostics;; history)history;; lab)lab;; backup)backup;; start)start_rf;; stop)stop_rf;; bm-api-key)bm_api_key;; web-password)web_password;; update-ids)update_ids;; bm)bm "$@";; version)cat "$APP/VERSION";; menu|"")menu;; *) echo "Usage: ywd-hotspotctl {status|source|update|update-channel|calibration|migrate-github|logs|lastheard|restart|configure|apply|health|diagnostics|history|lab|backup|start|stop|bm-api-key|web-password|update-ids|bm|version}"; exit 2;; esac
