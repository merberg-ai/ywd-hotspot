[Unit]
Description=YWD-Hotspot managed vocoder background job
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ywd-hotspot
Group=ywd-hotspot
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/var/lib/ywd-hotspot
ExecStart=/usr/bin/python3 /opt/ywd-hotspot/app/lib/vocoder_job_runner.py
SuccessExitStatus=0 2 3
Nice=10
CPUWeight=50
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/ywd-hotspot
StandardOutput=journal
StandardError=journal

[Install]
# Runtime-only worker. Jobs are started explicitly by the guarded admin helper.
