[Unit]
Description=YWD-Hotspot factory preconfiguration finalizer
After=local-fs.target
Before=ywd-setup.service
ConditionPathExists=/var/lib/ywd-hotspot/private/factory-provision.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/ywd-factory-provision
TimeoutStartSec=150
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
