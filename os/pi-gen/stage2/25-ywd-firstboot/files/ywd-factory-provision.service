[Unit]
Description=YWD-Hotspot factory preconfiguration finalizer
After=local-fs.target
Before=ywd-setup.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/ywd-factory-provision
TimeoutStartSec=210
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
