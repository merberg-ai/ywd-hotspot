+void WriteJSONToTopic(const std::string& topic, const std::string& topLevel, nlohmann::json& json)
+{
+	if (m_mqtt != nullptr) {
+		nlohmann::json top;
+
+		top[topLevel] = json;
+
+		m_mqtt->publish(topic.c_str(), top.dump());
+	}
+}
