[Unit]
Description=YWD-Hotspot secure first-boot setup wizard
After=network-online.target ywd-network-manager.service ywd-dashboard.service
Wants=network-online.target ywd-network-manager.service
ConditionPathExists=!/var/lib/ywd-hotspot/setup-state.json
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ywd-hotspot
Group=ywd-hotspot
RuntimeDirectory=ywd-hotspot
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/sudo -n /usr/local/libexec/ywd-hotspot-admin rf-stop
ExecStart=/opt/ywd-hotspot/app/lib/setup_entry.sh
Restart=on-failure
RestartSec=3
MemoryMax=96M
OOMScoreAdjust=250
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
