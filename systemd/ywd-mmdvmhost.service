[Unit]
Description=YWD Hotspot MMDVM-Host
After=network.target ywd-mqtt.service ywd-mmdvm-voice-build.service
# Voice tap preparation is deliberately best-effort. If its experimental build
# fails or times out, MMDVM-Host must still start with the existing known-good
# binary so normal hotspot operation is never held hostage by RX development.
Wants=ywd-mqtt.service ywd-mmdvm-voice-build.service
ConditionPathExists=/etc/ywd-hotspot/MMDVM-Host.ini
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ywd-hotspot
Group=ywd-hotspot
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/MMDVM-Host /etc/ywd-hotspot/MMDVM-Host.ini
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
OOMScoreAdjust=-200

[Install]
WantedBy=multi-user.target
