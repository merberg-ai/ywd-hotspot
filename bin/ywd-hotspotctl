#!/usr/bin/env bash
set -euo pipefail
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP=/opt/ywd-hotspot/app
CORE="$SELF/ywd-hotspotctl-core"
CHANNEL_FILE=/etc/ywd-hotspot/update-channel
BUILD_INFO=/etc/ywd-hotspot/build-info.json
CFG=/etc/ywd-hotspot/config.json
[[ -x "$CORE" ]] || CORE="$APP/bin/ywd-hotspotctl-core"
[[ -r "$SELF/ywd-ui.sh" ]] && source "$SELF/ywd-ui.sh"
[[ -x "$CORE" ]] || { echo "[FAIL] YWD-Hotspot CLI core not found." >&2; exit 1; }

cmd="${1:-menu}"
if [[ $EUID -ne 0 ]]; then
  case "$cmd" in
    status|source|calibration)
      if [[ ! -r /etc/ywd-hotspot/config.json || ! -r "$BUILD_INFO" ]]; then
        exec sudo "$0" "$@"
      fi
      ;;
    update-channel) exec sudo "$0" "$@";;
  esac
fi

pretty(){ if declare -F ywd_pretty_capture >/dev/null; then ywd_pretty_capture "$CORE" "$@"; else "$CORE" "$@"; fi; }

status_output(){
  local mode="simplex" rx="" tx=""
  local -a radio=()
  mapfile -t radio < <(python3 - "$CFG" <<'PY'
import json, sys
try:
    r = json.load(open(sys.argv[1], encoding='utf-8')).get('radio', {})
except Exception:
    r = {}
mode = str(r.get('mode', 'simplex')).strip().lower()
print(mode if mode in {'simplex', 'duplex'} else 'simplex')
print(f"{float(r.get('rx_frequency_hz', r.get('frequency_hz', 0))) / 1e6:.6f} MHz")
print(f"{float(r.get('tx_frequency_hz', r.get('frequency_hz', 0))) / 1e6:.6f} MHz")
PY
)
  mode="${radio[0]:-simplex}"
  rx="${radio[1]:-0.000000 MHz}"
  tx="${radio[2]:-0.000000 MHz}"

  if [[ "$mode" == "duplex" ]]; then
    "$CORE" status "$@" | awk -v rx="$rx" -v tx="$tx" '
      /^Frequency[[:space:]]/ {
        printf "%-18s %s\n", "Radio mode", "duplex"
        printf "%-18s %s\n", "Hotspot RX", rx
        printf "%-18s %s\n", "Hotspot TX", tx
        next
      }
      { print }
    '
  else
    "$CORE" status "$@" | awk '
      /^Frequency[[:space:]]/ {
        printf "%-18s %s\n", "Radio mode", "simplex"
      }
      { print }
    '
  fi
}

pretty_status(){
  if declare -F ywd_pretty_capture >/dev/null; then
    ywd_pretty_capture status_output "$@"
  else
    status_output "$@"
  fi
}

plugins_channel_active(){
  [[ -r "$CHANNEL_FILE" ]] && [[ "$(tr -d '[:space:]' < "$CHANNEL_FILE" 2>/dev/null || true)" == "dev-plugins" ]]
}

set_plugins_channel(){
  [[ $EUID -eq 0 ]] || exec sudo "$0" update-channel dev-plugins
  local tmp="${CHANNEL_FILE}.tmp"
  printf '%s\n' 'dev-plugins' > "$tmp"
  chmod 0644 "$tmp"
  chown root:root "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$CHANNEL_FILE"
  python3 - "$BUILD_INFO" <<'PY'
import json, os, sys
from pathlib import Path
p = Path(sys.argv[1])
try:
    d = json.loads(p.read_text())
except Exception:
    d = {}
d['update_channel'] = 'dev-plugins'
t = p.with_suffix(p.suffix + '.tmp')
t.write_text(json.dumps(d, indent=2) + '\n')
os.chmod(t, 0o644)
try:
    os.chown(t, 0, 0)
except Exception:
    pass
os.replace(t, p)
PY
  echo 'YWD-Hotspot update channel set to: dev-plugins'
  echo "Future CLI and WebUI updates will follow dev-plugins."
}

source_output(){
  if plugins_channel_active; then
    "$CORE" source | sed -E 's/^([[:space:]]*Channel[[:space:]]*:[[:space:]]*).*/\1dev-plugins/'
  else
    pretty source
  fi
}

menu(){
  while true; do
    clear
    local version="$(cat "$APP/VERSION" 2>/dev/null || echo unknown)"
    if declare -F ywd_banner >/dev/null; then ywd_banner "CONTROL CONSOLE" "$version"; else echo "YWD-Hotspot $version"; fi
    printf '%bSTATUS / TELEMETRY%b\n' "${YWD_CYAN:-}" "${YWD_RESET:-}"
    echo "  1  Status                 2  Last Heard"
    echo "  3  Logs                   7  Health"
    echo " 16  Config history        21  Calibration summary"
    printf '\n%bRF / BRANDMEISTER%b\n' "${YWD_MAGENTA:-}" "${YWD_RESET:-}"
    echo "  4  Restart running stack  8  Start/enable RF"
    echo "  9  Stop/disable RF       13  Drop current QSO"
    echo " 14  Drop dynamic TGs"
    printf '\n%bCONFIG / SUPPORT%b\n' "${YWD_BLUE:-}" "${YWD_RESET:-}"
    echo "  5  Configure (CLI)        6  Apply saved config"
    echo " 10  BM API key            11  Web control password"
    echo " 12  Update DMR IDs        15  Diagnostic bundle"
    echo " 17  Hardware Lab"
    printf '\n%bGITHUB / BUILD%b\n' "${YWD_GREEN:-}" "${YWD_RESET:-}"
    echo " 18  Source/build info     19  Check update"
    echo " 20  Update from GitHub    22  Show update channel"
    echo " 23  Set channel: dev      24  Set channel: main"
    echo " 25  Set channel: dev-plugins"
    echo
    printf '  %b0%b  Exit\n\n' "${YWD_DIM:-}" "${YWD_RESET:-}"
    read -r -p "ywd> " n
    case "$n" in
      1) pretty_status;; 2) pretty lastheard;; 3) "$CORE" logs;; 4) "$CORE" restart;;
      5) "$CORE" configure;; 6) "$CORE" apply;; 7) pretty health;; 8) "$CORE" start;; 9) "$CORE" stop;;
      10) "$CORE" bm-api-key;; 11) "$CORE" web-password;; 12) "$CORE" update-ids;;
      13) "$CORE" bm dropqso;; 14) "$CORE" bm dropdyn;; 15) "$CORE" diagnostics;; 16) pretty history;;
      17) "$CORE" lab;; 18) source_output;; 19) "$0" update --check;; 20) "$0" update;;
      21) pretty calibration;; 22) "$0" update-channel;; 23) "$CORE" update-channel dev;; 24) "$CORE" update-channel main;;
      25) set_plugins_channel;;
      0) return;; *) ywd_warn "Unknown selection: $n" 2>/dev/null || echo "Unknown selection";;
    esac
    echo; read -r -p "Press Enter to continue..." _
  done
}

case "$cmd" in
  menu|"") menu;;
  status) shift || true; pretty_status "$@";;
  lastheard|health|history) shift || true; pretty "$cmd" "$@";;
  source) shift || true; source_output "$@";;
  calibration)
    if [[ "${2:-}" == "export" ]]; then exec "$CORE" "$@"; fi
    shift || true; pretty calibration "$@";;
  update-channel)
    if [[ $# -eq 1 ]]; then
      if plugins_channel_active; then echo 'Update channel: dev-plugins'; echo 'Available channels: main dev dev-plugins'; else pretty update-channel; fi
    elif [[ "${2:-}" == "dev-plugins" ]]; then
      set_plugins_channel
    else
      exec "$CORE" "$@"
    fi;;
  update)
    shift || true
    if declare -F ywd_banner >/dev/null; then ywd_banner "UPDATE CONTROL" "$(cat "$APP/VERSION" 2>/dev/null || echo unknown)"; fi
    exec "$CORE" update "$@";;
  version) exec "$CORE" version;;
  *) exec "$CORE" "$@";;
esac
