[Unit]
Description=YWD Hotspot passive DMR voice tap build
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/ywd-hotspot/app/lib/mmdvm_patches/0001-ywd-dmr-voice-mqtt.patch

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/ywd-hotspot/app/lib/mmdvm_voice_build.py ensure
# The original Pi Zero W is a single-core ARMv6 target. Keep the experimental
# compile out of the RF critical path and heavily de-prioritized while normal
# hotspot services continue running.
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h
