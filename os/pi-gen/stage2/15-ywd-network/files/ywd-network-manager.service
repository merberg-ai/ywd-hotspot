[Unit]
Description=YWD-Hotspot OS WiFi station/setup/recovery manager
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/ywd-network-manager.py
Restart=always
RestartSec=5
RuntimeDirectory=ywd-hotspot-os
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
