+void CDMRSlot::writeJSONVoice(const char* source, const CDMRData& dmrData)
+{
+	assert(source != nullptr);
+
+	unsigned char payload[DMR_FRAME_LENGTH_BYTES];
+	dmrData.getData(payload);
+
+	static const char HEX[] = "0123456789abcdef";
+	std::string frameHex;
+	frameHex.reserve(DMR_FRAME_LENGTH_BYTES * 2U);
+	for (unsigned int i = 0U; i < DMR_FRAME_LENGTH_BYTES; i++) {
+		frameHex.push_back(HEX[(payload[i] >> 4) & 0x0FU]);
+		frameHex.push_back(HEX[payload[i] & 0x0FU]);
+	}
+
+	nlohmann::json json;
+	json["timestamp"]  = CUtils::createTimestamp();
+	json["source"]     = source;
+	json["slot"]       = int(dmrData.getSlotNo());
+	json["frame_kind"] = dmrData.getDataType() == DT_VOICE_SYNC ? "voice_sync" : "voice";
+	json["data_type"]  = int(dmrData.getDataType());
+	json["src_id"]     = int(dmrData.getSrcId());
+	json["dst_id"]     = int(dmrData.getDstId());
+	json["group"]      = dmrData.getFLCO() == FLCO::GROUP ? "yes" : "no";
+	json["seq_no"]     = int(dmrData.getSeqNo());
+	json["n"]          = int(dmrData.getN());
+	json["ber"]        = int(dmrData.getBER());
+	json["rssi"]       = int(dmrData.getRSSI());
+	json["frame_hex"]  = frameHex;
+
+	// Voice frames use a dedicated loopback MQTT topic so the existing
+	// low-rate telemetry snapshot never has to parse or rewrite per frame.
+	WriteJSONToTopic("voice", "DMRVoice", json);
+}
