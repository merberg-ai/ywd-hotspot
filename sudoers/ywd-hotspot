# YWD-Hotspot: the unprivileged dashboard/setup services may invoke only these
# validated root-helper actions. The dispatcher itself is root-owned and has
# no arbitrary-command action.
Cmnd_Alias YWDHOTSPOT_ADMIN = \
 /usr/local/libexec/ywd-hotspot-admin config-save, \
 /usr/local/libexec/ywd-hotspot-admin config-apply, \
 /usr/local/libexec/ywd-hotspot-admin config-revert, \
 /usr/local/libexec/ywd-hotspot-admin set-hotspot-password, \
 /usr/local/libexec/ywd-hotspot-admin set-bm-api-key, \
 /usr/local/libexec/ywd-hotspot-admin set-web-password, \
 /usr/local/libexec/ywd-hotspot-admin setup-finish, \
 /usr/local/libexec/ywd-hotspot-admin settings-export, \
 /usr/local/libexec/ywd-hotspot-admin settings-preview, \
 /usr/local/libexec/ywd-hotspot-admin settings-import, \
 /usr/local/libexec/ywd-hotspot-admin update-check, \
 /usr/local/libexec/ywd-hotspot-admin update-start, \
 /usr/local/libexec/ywd-hotspot-admin rf-start, \
 /usr/local/libexec/ywd-hotspot-admin rf-stop, \
 /usr/local/libexec/ywd-hotspot-admin rf-restart, \
 /usr/local/libexec/ywd-hotspot-admin service-restart, \
 /usr/local/libexec/ywd-hotspot-admin reboot, \
 /usr/local/libexec/ywd-hotspot-admin diagnostics, \
 /usr/local/libexec/ywd-hotspot-admin calibration-baseline-save, \
 /usr/local/libexec/ywd-hotspot-admin calibration-baseline-restore, \
 /usr/local/libexec/ywd-hotspot-admin plugin-system-set, \
 /usr/local/libexec/ywd-hotspot-admin plugin-set, \
 /usr/local/libexec/ywd-hotspot-admin plugin-config-save, \
 /usr/local/libexec/ywd-hotspot-admin plugin-runtime, \
 /usr/local/libexec/ywd-hotspot-admin plugin-package-install, \
 /usr/local/libexec/ywd-hotspot-admin plugin-package-uninstall, \
 /usr/local/libexec/ywd-hotspot-admin plugin-data-remove, \
 /usr/local/libexec/ywd-hotspot-admin plugin-package-upload, \
 /usr/local/libexec/ywd-hotspot-admin plugin-package-remove

ywd-hotspot ALL=(root) NOPASSWD: YWDHOTSPOT_ADMIN
